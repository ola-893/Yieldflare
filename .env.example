# FlareYield Deployment Configuration

# ═══════════════════════════════════════════════════════════════════════════
# Network Configuration
# ═══════════════════════════════════════════════════════════════════════════

# Coston2 Testnet RPC
COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc

# Flare Mainnet RPC
FLARE_RPC_URL=https://flare-api.flare.network/ext/C/rpc

# ═══════════════════════════════════════════════════════════════════════════
# Deployment Configuration
# ═══════════════════════════════════════════════════════════════════════════

# Deployer address (derived from encrypted keystore, not private key)
# Use: cast wallet import deployer --interactive
# Then: forge script --account deployer
DEPLOYER_ADDRESS=0xYourDeployerAddressHere

# DAO multisig address (receives ownership of contracts)
DAO_MULTISIG=0xYourMultisigAddressHere

# FCC signer address (authorized to sign rebalance instructions)
# This should be the address controlled by your off-chain rebalance worker
FCC_SIGNER_ADDRESS=0xYourFccSignerAddressHere

# Default direct mint executor address (authorized to call processDirectMint)
# This should be the address controlled by your XRPL event watcher service
DEFAULT_DIRECT_MINT_EXECUTOR=0xYourExecutorAddressHere

# Performance fee in basis points (1000 = 10%)
PERFORMANCE_FEE_BPS=1000

# ═══════════════════════════════════════════════════════════════════════════
# Mainnet-Only Configuration (not needed for Coston2)
# ═══════════════════════════════════════════════════════════════════════════

# Kinetic JOULE reward token address (mainnet only)
JOULE_TOKEN_ADDRESS=0xYourJouleTokenAddressHere

# ═══════════════════════════════════════════════════════════════════════════
# Contract Verification (optional)
# ═══════════════════════════════════════════════════════════════════════════

# Flare/Coston2 explorer API key (if using --verify)
ETHERSCAN_API_KEY=YourApiKeyHere
