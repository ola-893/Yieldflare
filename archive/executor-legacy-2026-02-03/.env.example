# ═══════════════════════════════════════════════════════════════════════════
# FlareYield Executor Bot — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════

# Private key of the DEFAULT_DIRECT_MINT_EXECUTOR address.
# This account must be the authorized executor for all registered minting tags.
# On testnet this is typically the deployer key.
EXECUTOR_PRIVATE_KEY=0xYourPrivateKeyHere

# ═══════════════════════════════════════════════════════════════════════════
# Flare Coston2 Network
# ═══════════════════════════════════════════════════════════════════════════
COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc

# Deployed contract addresses on Coston2
FASSET_ADAPTER_ADDRESS=0x02D4F85301A2d1b3Bcc40BfD7937e6Fb2F5224a7
FXRP_ADDRESS=0x0b6A3645c240605887a5532109323A3E12273dc7
ASSET_MANAGER_ADDRESS=0xc1Ca88b937d0b528842F95d5731ffB586f4fbDFA
MINTING_TAG_MANAGER_ADDRESS=0x094511737909b626391106bBc21B25feb2D67B96

# ═══════════════════════════════════════════════════════════════════════════
# XRPL Testnet
# ═══════════════════════════════════════════════════════════════════════════
XRPL_WSS_URL=wss://s.altnet.rippletest.net:51233

# The Core Vault XRPL address that receives direct minting payments.
# If blank, the executor reads it on startup from AssetManager.directMintingPaymentAddress().
XRPL_CORE_VAULT_ADDRESS=

# ═══════════════════════════════════════════════════════════════════════════
# Polling
# ═══════════════════════════════════════════════════════════════════════════

# How often (ms) to poll XRPL for new payments when WebSocket subscription
# is unavailable or as a fallback.  Default: 15000 (15 seconds).
POLL_INTERVAL_MS=15000
