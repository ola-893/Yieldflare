# FCE Extension Scaffold Configuration
# Copy to fce-extension-scaffold/.env after cloning

# Deployment Configuration
DEPLOYMENT_PRIVATE_KEY=your_private_key_here
INITIAL_OWNER=your_address_here
CHAIN_URL=https://coston2-api.flare.network/ext/C/rpc

# Mode Configuration
LOCAL_MODE=false
SIMULATED_TEE=true

# Extension Proxy Configuration
EXT_PROXY_URL=https://your-ngrok-url.ngrok.io

# Registry Addresses (from deployed-addresses.json)
TEE_EXTENSION_REGISTRY=0x1a9C4A0f9D76c0b1D91d22E24E573a9b377618aE
TEE_MACHINE_REGISTRY=0x1a9C4A0f9D76c0b1D91d22E24E573a9b377618aE

# Your Deployed InstructionSender (from Phase 2)
INSTRUCTION_SENDER=your_instruction_sender_address_here

# Indexer Database (get credentials from Flare support)
INDEXER_HOST=34.38.42.208
INDEXER_PORT=3306
INDEXER_DATABASE=indexer
INDEXER_USERNAME=contact_flare_support
INDEXER_PASSWORD=contact_flare_support
