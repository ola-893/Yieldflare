# FlareYield Frontend Configuration
# Copy this file to .env and update with your deployed contract addresses

# Network Configuration
VITE_CHAIN_ID=114
VITE_NETWORK_NAME=Coston2
VITE_RPC_URL=https://coston2-api.flare.network/ext/C/rpc

# Core Protocol Contracts (update after deployment)
VITE_PARENT_VAULT_ADDRESS=0xYourParentVaultAddress
VITE_FASSET_ADAPTER_ADDRESS=0xYourFAssetAdapterAddress

# Token Addresses
VITE_FXRP_ADDRESS=0xYourFXRPAddress

# FAsset Infrastructure
VITE_ASSET_MANAGER_FXRP_ADDRESS=0xYourAssetManagerAddress
VITE_MINTING_TAG_MANAGER_ADDRESS=0xYourMintingTagManagerAddress

# Explorer
VITE_EXPLORER_URL=https://coston2-explorer.flare.network

# FCE (Flare Compute Extension)
# In development, leave unset to use Vite proxy (/fce-api → localhost:8080)
# In production, set to the FCE extension URL
# VITE_FCE_ENDPOINT=http://localhost:8080

# Deployer Info (optional)
VITE_DEPLOYER_ADDRESS=0xYourDeployerAddress
